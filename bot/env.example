# Discord Bot Configuration
DISCORD_TOKEN=your-discord-bot-token-here

# Optional: Guild ID für Slash-Commands (nur in einem Server)
GUILD_ID=optional-guild-id

# WebSocket Hub Configuration
HUB_URL=http://localhost:3001

# Authentifizierung des Bots am Hub
# Invite-Modus (empfohlen): HUB_SECRET = per /invite ausgegebenes Token, HUB_OWNER_ID = ownerId aus /invite
#   Beispiel: curl -X POST $HUB_URL/invite -H 'content-type: application/json' -d '{"inviteCode":"supersecret1","ownerId":"discord-bot"}'
#   Dann: HUB_SECRET=<token-aus-response>
HUB_SECRET=
HUB_OWNER_ID=

# Legacy (Invite aus): HUB_SECRET = BROADCAST_SECRET des Servers, HUB_OWNER_ID leer lassen.
