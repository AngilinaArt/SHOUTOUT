# WebSocket Hub Server Configuration
PORT=3001

# Proxy-Weiterleitungen korrekt behandeln (Express 'trust proxy').
# Erlaubte Werte: false | 1 | 'loopback' | '127.0.0.1' | 'uniquelocal' | Subnet (z. B. '10.0.0.0/8')
# In Production hinter genau einem Proxy (z. B. Caddy): TRUST_PROXY=1
# Lokal ohne Proxy: TRUST_PROXY=loopback (oder false)
TRUST_PROXY=loopback

# Security: Bearer Token für Broadcast-Endpoint
# WICHTIG: Ändere diesen Wert zu einem sicheren, zufälligen Token!
BROADCAST_SECRET=change-me-to-a-secure-random-token-123

# Sicherheit: Auth aktivieren (true = Token erforderlich, false = Keine Auth)
ALLOW_NO_AUTH=false

# Beispiel für einen sicheren Token:
# BROADCAST_SECRET=hamster-toast-secure-2025-xyz789abc123

# Invite-System
# Für den einfachen Betrieb deaktivieren:
INVITE_ENABLED=false
# Optional: Invite-Codes (nur wenn INVITE_ENABLED=true)
# INVITE_CODES=supersecret1,supersecret2

# Admin API Secret for token management endpoints (/tokens, /revoke/:token)
# Required to access admin endpoints. Example:
ADMIN_SECRET=super-admin-123

# Optional: Image/App version for Docker labels (overrides default 'dev')
APP_VERSION=1.0.1

# --- Translation (optional, local, offline) ---
# Enable translate endpoint
# TRANSLATOR_ENABLED=true
# Provider: 'ct2' for CTranslate2 python stub, or 'none'
# TRANSLATOR_PROVIDER=ct2
# Pre-Clean + Auto-Fallback (bei unsicherer Spracherkennung):
# TRANSLATOR_AUTOFIX=true
# Path to python script (default points into repo)
# TRANSLATOR_PY=./src/translate/ct2_translator.py
# CTranslate2 model paths (set both for DE<->EN)
# CT2_MODEL_DE_EN=/absolute/path/to/ct2_models/de-en
# CT2_MODEL_EN_DE=/absolute/path/to/ct2_models/en-de
